set term pdfcairo enhanced color size 12in,4.4in font "Helvetica,15"
set datafile separator "\t"
set border 3 linewidth 1.2
set tics out nomirror
set grid ytics linewidth 1 linecolor rgb "#d8d8d8"
set key opaque box linewidth 0.8 samplen 1.3 spacing 0.9

set style line 1 linecolor rgb "#d9bd16" linewidth 3 pointtype 7 pointsize 1.1
set style line 2 linecolor rgb "#7076e4" linewidth 3 pointtype 5 pointsize 1.1
set style line 3 linecolor rgb "#65b985" linewidth 3 pointtype 11 pointsize 1.1
set style line 4 linecolor rgb "#d90000" linewidth 3 pointtype 9 pointsize 1.1
