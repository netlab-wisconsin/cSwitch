<?xml version="1.0"?>
<benchmark>
  <!-- Number of threads (including master) -->
  <nthreads>4</nthreads>

  <!-- Latency memory size: supports suffixes k, m, g -->
  <memory>128m</memory>

  <!-- Worker memory per thread in MB -->
  <worker_memory_mb>256</worker_memory_mb>

  <!-- Output file for latency results -->
  <output>./res/latency_out.txt</output>

  <!-- Run in bandwidth-only mode -->
  <bandwidth>true</bandwidth>

  <!-- Duration for bandwidth mode (seconds) -->
  <time>20000</time>

  <!-- CPU clock in GHz for ns conversion -->
  <clock>2.25</clock>

  <!-- Suppress writing raw latency values -->
  <silent>true</silent>

  <!-- Per-thread core assignments (comma separated) -->
