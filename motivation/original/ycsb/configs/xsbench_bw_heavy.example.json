{
  "ycsb_root": "../YCSB",
  "result_root": "../results",
  "result_prefix": "xsbench_bw_heavy",
  "keep_result_db": false,
  "fail_fast": true,
  "monitoring": {
    "event_name": "NO_RETIRED_INST_CYCLES",
    "perf_event": "cpu/event=0xc0,cmask=1,inv=1/",
    "df_enabled": true,
    "df_resource_family": "CCM",
    "df_resource_ids": [0],
    "df_sample_slot_ms": 20
  },
  "assignment_generator": {
    "kind": "prefix_density",
    "counts": [1],
    "base_core": 0,
    "label_prefix": "prefix_x"
  },
  "backends": [
    {
      "name": "xsbench",
      "threads_per_instance": 1,
      "options": {
        "xsbench_root": "../benchmarks/XSBench/openmp-threading",
        "simulation_method": "event",
        "size": "XL",
        "gridpoints": "50000",
        "grid_type": "unionized",
        "kernel": "0",
        "lookups": "10000000",
        "benchmark_class": "event_xl_gp120k_unionized_bw_heavy"
      },
      "env": {
        "OMP_PROC_BIND": "close",
        "OMP_PLACES": "cores"
      }
    }
  ]
}
