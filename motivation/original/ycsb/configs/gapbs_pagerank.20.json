      "options": {
        "gapbs_root": "/home/seunghyun/gapbs/gapbs",
        "graph": "/home/seunghyun/gapbs/gapbs/benchmark/graphs/twitter.sg",
        "trials": "1",
        "iterations": "1000",
        "tolerance": "1e-4",
        "benchmark_class": "twitter"
      },
      "env": {
        "OMP_PROC_BIND": "close",
        "OMP_PLACES": "cores"
      }
    }
  ]
