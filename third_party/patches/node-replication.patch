+fn parse_allowed_cpus(spec: &str) -> Result<HashSet<Cpu>, String> {
+    let mut cpus = HashSet::new();
+    for item in spec.split(',') {
+        let item = item.trim();
+        if item.is_empty() {
+            continue;
+        }
+        if let Some((start, end)) = item.split_once('-') {
+            let start = start
+                .trim()
+                .parse::<Cpu>()
+                .map_err(|err| format!("invalid cpu range start {start:?}: {err}"))?;
+            let end = end
+                .trim()
+                .parse::<Cpu>()
+                .map_err(|err| format!("invalid cpu range end {end:?}: {err}"))?;
+            if start > end {
+                return Err(format!("invalid cpu range {item:?}: start > end"));
+            }
+            for cpu in start..=end {
+                cpus.insert(cpu);
+            }
+        } else {
+            let cpu = item
+                .parse::<Cpu>()
+                .map_err(|err| format!("invalid cpu id {item:?}: {err}"))?;
+            cpus.insert(cpu);
+        }
+    }
+    Ok(cpus)
+}
+
+fn allowed_cpus_from_env() -> Option<HashSet<Cpu>> {
+    for name in ["BENCH_UTILS_ALLOWED_CPUS", "NR_ALLOWED_CPUS"] {
+        if let Ok(value) = std::env::var(name) {
+            let value = value.trim();
+            if value.is_empty() {
+                continue;
+            }
+            return Some(parse_allowed_cpus(value).unwrap_or_else(|err| {
+                panic!("failed to parse {name}={value:?}: {err}")
+            }));
+        }
+    }
+    None
+}
+
