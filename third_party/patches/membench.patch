+namespace {
+
+constexpr int kSignalThreadWakeSignal = SIGUSR1;
+constexpr auto kStopPollInterval = std::chrono::milliseconds(50);
+
+class ScopedSignalWaiter {
+public:
+  explicit ScopedSignalWaiter(SharedState &state) : state_(state) {
+    sigemptyset(&handled_signals_);
+    sigaddset(&handled_signals_, SIGINT);
+    sigaddset(&handled_signals_, SIGTERM);
+    sigaddset(&handled_signals_, kSignalThreadWakeSignal);
+
+    const int mask_result =
+        pthread_sigmask(SIG_BLOCK, &handled_signals_, nullptr);
+    if (mask_result != 0) {
+      throw std::runtime_error("Failed to block benchmark control signals.");
+    }
+
+    waiter_thread_ = std::thread([this]() { wait_for_signal(); });
+  }
+
+  ~ScopedSignalWaiter() {
+    shutdown_requested_.store(true, std::memory_order_relaxed);
+    if (waiter_thread_.joinable()) {
+      pthread_kill(waiter_thread_.native_handle(), kSignalThreadWakeSignal);
+      waiter_thread_.join();
+    }
+  }
+
+  ScopedSignalWaiter(const ScopedSignalWaiter &) = delete;
+  ScopedSignalWaiter &operator=(const ScopedSignalWaiter &) = delete;
+
+private:
+  void wait_for_signal() {
+    int received_signal = 0;
+    while (::sigwait(&handled_signals_, &received_signal) == 0) {
+      if (received_signal == kSignalThreadWakeSignal) {
+        if (shutdown_requested_.load(std::memory_order_relaxed)) {
+          return;
+        }
+        continue;
+      }
+
+      const bool already_stopping =
+          state_.finished.exchange(true, std::memory_order_relaxed);
+      if (!already_stopping) {
+        std::cerr << "\nReceived signal " << received_signal
+                  << ". Stopping benchmark and printing partial bandwidth "
+                     "results.\n";
+      }
+    }
+  }
+
+  SharedState &state_;
+  sigset_t handled_signals_{};
+  std::atomic<bool> shutdown_requested_{false};
+  std::thread waiter_thread_;
+};
+
+template <typename Duration>
+bool wait_for_duration_or_stop(const Duration &duration, SharedState &state) {
+  const auto deadline = std::chrono::steady_clock::now() + duration;
+  while (!state.finished.load(std::memory_order_relaxed)) {
+    const auto now = std::chrono::steady_clock::now();
+    if (now >= deadline) {
+      return true;
+    }
+
+    const auto remaining = deadline - now;
+    std::this_thread::sleep_for(
+        remaining < kStopPollInterval ? remaining : kStopPollInterval);
+  }
+
+  return false;
+}
+
