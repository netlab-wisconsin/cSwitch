+void *allocate_interleaved_subset(std::size_t size, const std::vector<int> &nodes)
+{
+    if (nodes.empty())
+    {
+        throw std::runtime_error("Interleaved NUMA allocation requires at least one node.");
+    }
+
+    struct bitmask *mask = numa_bitmask_alloc(numa_max_node() + 1);
+    if (!mask)
+    {
+        throw std::runtime_error("Failed to allocate NUMA bitmask.");
+    }
+
+    for (int node : nodes)
+    {
+        if (node < 0 || node > numa_max_node())
+        {
+            numa_bitmask_free(mask);
+            throw std::runtime_error("Interleave NUMA node is out of range.");
+        }
+        numa_bitmask_setbit(mask, node);
+    }
+
+    void *memory = numa_alloc_interleaved_subset(size, mask);
+    numa_bitmask_free(mask);
+    if (!memory)
+    {
+        throw std::runtime_error("Failed to allocate interleaved NUMA memory.");
+    }
+    return memory;
+}
