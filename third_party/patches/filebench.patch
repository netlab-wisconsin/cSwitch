diff --git a/stats.c b/stats.c
index b511789..731fc59 100644
--- a/stats.c
+++ b/stats.c
@@ -44,6 +44,57 @@
 /* Global statistics */
 static struct flowstats *globalstats = NULL;
 
+static unsigned long long
+stats_histogram_percentile_ns(struct flowstats *stats, double percentile)
+{
+	unsigned long long rank;
+	unsigned long long lower_ns;
+	unsigned long long upper_ns;
+	unsigned long long cumulative;
+	unsigned long long bucket_count;
+	unsigned long long previous;
+	double rank_f;
+	double fraction;
+	int i;
+
+	if (!stats || stats->fs_count <= 0)
+		return (0);
+
+	if (percentile <= 0.0)
+		return (stats->fs_minlat == ULLONG_MAX ? 0 : stats->fs_minlat);
+	if (percentile >= 100.0)
+		return (stats->fs_maxlat);
+
+	rank_f = ((double) stats->fs_count * percentile) / 100.0;
+	rank = (unsigned long long) rank_f;
+	if ((double) rank < rank_f)
+		rank++;
+	if (rank == 0)
+		rank = 1;
+
+	cumulative = 0;
+	for (i = 0; i < OSPROF_BUCKET_NUMBER; i++) {
+		bucket_count = stats->fs_distribution[i];
+		if (bucket_count == 0)
+			continue;
+		previous = cumulative;
+		cumulative += bucket_count;
+		if (cumulative < rank)
+			continue;
+
+		lower_ns = (i == 0) ? 0 : (1ULL << (i - 1));
+		upper_ns = (1ULL << i);
+		fraction = ((double) (rank - previous)) / (double) bucket_count;
+		if (fraction < 0.0)
+			fraction = 0.0;
+		if (fraction > 1.0)
+			fraction = 1.0;
+		return (unsigned long long) (lower_ns + ((upper_ns - lower_ns) * fraction));
+	}
+
+	return (stats->fs_maxlat);
+}
+
 /*
  * Add a flowstat b to a, leave sum in a.
  */
@@ -60,14 +111,16 @@ stats_add(struct flowstats *a, struct flowstats *b)
 	a->fs_wbytes += b->fs_wbytes;
 	a->fs_total_lat += b->fs_total_lat;
 
-	if (b->fs_maxlat > a->fs_maxlat)
-		a->fs_maxlat = b->fs_maxlat;
+	if (b->fs_count > 0) {
+		if (b->fs_maxlat > a->fs_maxlat)
+			a->fs_maxlat = b->fs_maxlat;
 
-	if (b->fs_minlat < a->fs_minlat)
-		a->fs_minlat = b->fs_minlat;
+		if (b->fs_minlat < a->fs_minlat)
+			a->fs_minlat = b->fs_minlat;
 
-	for (i = 0; i < OSPROF_BUCKET_NUMBER; i++)
-		a->fs_distribution[i] += b->fs_distribution[i];
+		for (i = 0; i < OSPROF_BUCKET_NUMBER; i++)
+			a->fs_distribution[i] += b->fs_distribution[i];
+	}
 }
 
